        { "at": 60000, "kind": "complete_set", "payload": { "step": 4 }, "expect": "ok", "after": { "rest_ends_at": null } },
        { "at": 70000, "kind": "complete_set", "payload": { "step": 5 }, "expect": "ok", "after": { "rest_ends_at": null, "cursor": 6 } },
        { "at": 80000, "kind": "complete_set", "payload": { "step": 6 }, "expect": "no_step" },
        { "at": 90000, "kind": "end", "expect": "ok" }
      ],
      "final": { "outcome": "completed" }
    },
    {
      "name": "pause during rest freezes it; resume extends rest_ends_at by the pause",
      "blocks": "straight3",
      "commands": [
        { "at": 0, "kind": "start", "expect": "ok" },
        { "at": 10000, "kind": "complete_set", "payload": { "step": 0 }, "expect": "ok", "after": { "rest_ends_at": 70000 } },
        { "at": 20000, "kind": "pause", "expect": "ok", "after": { "state": "paused", "paused_at": 20000 } },
        { "at": 25000, "kind": "complete_set", "payload": { "step": 1 }, "expect": "invalid_state" },
        { "at": 25000, "kind": "skip_rest", "expect": "invalid_state" },
        { "at": 50000, "kind": "resume", "expect": "ok", "after": { "state": "active", "paused_at": null, "paused_ms": 30000, "rest_ends_at": 100000 } },
        { "at": 60000, "kind": "pause", "expect": "ok" },
        { "at": 70000, "kind": "resume", "expect": "ok", "after": { "paused_ms": 40000, "rest_ends_at": 110000 } }
      ],
      "final": { "state": "active", "pauses": [ { "from": 20000, "to": 50000 }, { "from": 60000, "to": 70000 } ] }
    },
    {
      "name": "stale revision: set commands rejected, pause/resume/end still applied when valid",
      "blocks": "straight3",
      "commands": [
        { "at": 0, "kind": "start", "expect": "ok" },
        { "at": 1000, "kind": "complete_set", "payload": { "step": 0 }, "rev": 1, "expect": "stale_revision" },
