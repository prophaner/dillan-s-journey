    {
      "name": "superset rests only after the last member and never after the final round",
      "blocks": "superset2x3",
      "commands": [
        { "at": 0, "kind": "start", "expect": "ok" },
        { "at": 10000, "kind": "complete_set", "payload": { "step": 0 }, "expect": "ok", "after": { "rest_ends_at": null } },
        { "at": 20000, "kind": "complete_set", "payload": { "step": 1 }, "expect": "ok", "after": { "rest_ends_at": 110000 } },
        { "at": 30000, "kind": "skip_rest", "expect": "ok", "after": { "rest_ends_at": null, "rest_started_at": null } },
        { "at": 40000, "kind": "complete_set", "payload": { "step": 2 }, "expect": "ok", "after": { "rest_ends_at": null } },
