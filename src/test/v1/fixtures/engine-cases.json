        { "at": 3000, "kind": "pause", "rev": 1, "expect": "ok", "after": { "revision": 3 } },
        { "at": 4000, "kind": "pause", "rev": 2, "expect": "stale_revision" },
        { "at": 4000, "kind": "pause", "expect": "invalid_state" },
        { "at": 5000, "kind": "resume", "rev": 2, "expect": "ok", "after": { "revision": 4, "paused_ms": 2000 } },
        { "at": 6000, "kind": "resume", "rev": 3, "expect": "stale_revision" },
        { "at": 9000, "kind": "end", "rev": 1, "expect": "ok" }
      ],
      "final": { "state": "ended", "outcome": "partial", "revision": 5 }
    },
    {
      "name": "ended is terminal",
