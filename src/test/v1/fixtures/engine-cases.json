      "name": "straight sets complete: rest after each set except the last, outcome completed",
      "blocks": "straight3",
      "commands": [
        { "at": 0, "kind": "start", "expect": "ok", "after": { "state": "active", "started_at": 0, "revision": 2 } },
        { "at": 30000, "kind": "complete_set", "payload": { "step": 0 }, "expect": "ok", "after": { "cursor": 1, "rest_started_at": 30000, "rest_ends_at": 90000 } },
