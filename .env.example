# Dillan V1 environment template. Placeholders only: never commit real secrets.
# Copy to .env for local development. Lovable manages the real values for hosted builds.

# Browser (public by design: project URL and publishable/anon key)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Server-side rendering and server functions (same public values)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
SUPABASE_PROJECT_ID=<project-ref>

# SUPABASE_SERVICE_ROLE_KEY is a hosting secret used only by server functions
# (TV pairing, Delete account) via src/integrations/supabase/client.server.ts.
# Do NOT put it in this file, in .env, or anywhere in the repository.
