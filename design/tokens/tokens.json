      },
      "steadyTint": {
        "value": "#DDEFE4"
      },
      "hold": {
        "value": "#855610",
        "use": "Waiting on you / needs a decision. NEVER for missed sessions."
      },
      "holdTint": {
        "value": "#FBEED3"
      },
      "unknown": {
        "value": "#8F8A80",
        "use": "Dashed borders for unknown / not measured. Graphics only, never text."
      }
