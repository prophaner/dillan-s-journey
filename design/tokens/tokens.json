      "surface2": {
        "value": "#282724"
      },
      "line": {
        "value": "#33312C"
      },
      "text": {
        "value": "#F3EFE6"
      },
      "text2": {
        "value": "#B3AEA3"
      },
      "text3": {
        "value": "#8E897F"
      },
      "accent": {
        "value": "#FF6A30",
        "onAccent": "#1A1A18"
      },
      "accentText": {
        "value": "#FF8A5C"
      },
      "accentTint": {
        "value": "#3A2117"
      },
      "steady": {
        "value": "#62C190"
      },
      "steadyTint": {
        "value": "#183326"
