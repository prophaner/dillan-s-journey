  "font": {
    "ui": {
      "family": "Satoshi",
      "weights": [
        400,
        500,
        700
      ],
      "stack": "\"Satoshi\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "license": "Fontshare (free)",
      "source": "https://www.fontshare.com/fonts/satoshi",
      "rule": "Records, controls, labels, human coach messages"
    },
    "voice": {
      "family": "Newsreader",
      "weights": "variable 400 (optical size 16–24)",
      "stack": "\"Newsreader\", \"Iowan Old Style\", Georgia, serif",
      "license": "OFL",
      "source": "https://fonts.google.com/specimen/Newsreader",
      "rule": "Only for sentences authored by Dillan"
    },
    "num": {
      "family": "M PLUS Rounded 1c",
      "weights": [
        700,
        800
      ],
      "stack": "\"M PLUS Rounded 1c\", \"Satoshi\", system-ui, sans-serif",
      "license": "OFL",
      "source": "https://fonts.google.com/specimen/M+PLUS+Rounded+1c",
      "rule": "Reps, loads, timers, metrics; always font-variant-numeric: tabular-nums"
    },
    "hosting": "Self-host woff2 in production (offline + CSP). CDN links are for the prototype only."
  },
  "type": {
    "voiceXL": {
      "size": 31,
      "lineHeight": 36,
      "font": "voice",
      "weight": "regular",
      "rem": 1.9375
    },
    "voice": {
      "size": 19,
      "lineHeight": 26,
      "font": "voice",
      "weight": "regular",
      "rem": 1.1875
    },
    "voiceS": {
      "size": 17,
      "lineHeight": 24,
      "font": "voice",
      "weight": "regular",
      "rem": 1.0625
    },
    "largeTitle": {
      "size": 34,
      "weight": "bold",
      "rem": 2.125
    },
    "title1": {
      "size": 28,
      "weight": "bold",
      "rem": 1.75
    },
    "title2": {
      "size": 22,
      "weight": "bold",
      "rem": 1.375
    },
    "title3": {
      "size": 20,
      "weight": "semibold",
      "rem": 1.25
    },
    "headline": {
      "size": 17,
      "weight": "semibold",
      "rem": 1.0625
    },
    "body": {
      "size": 17,
      "weight": "regular",
      "rem": 1.0625
    },
    "callout": {
      "size": 16,
      "weight": "regular",
      "rem": 1.0
    },
    "subhead": {
      "size": 15,
      "weight": "regular",
      "rem": 0.9375
    },
    "footnote": {
      "size": 13,
      "weight": "regular",
      "rem": 0.8125
    },
    "caption": {
      "size": 12,
      "weight": "medium",
      "rem": 0.75
    },
    "numXL": {
      "size": 88,
      "font": "num",
      "weight": "semibold",
      "use": "Rest timer",
      "rem": 5.5
    },
    "numL": {
      "size": 64,
      "font": "num",
      "weight": "semibold",
      "use": "Reps and load in set card",
      "rem": 4.0
    },
    "numM": {
      "size": 44,
      "font": "num",
      "weight": "semibold",
      "use": "Progress headline metric",
      "rem": 2.75
    },
    "voiceDesktop": {
      "size": 44,
      "lineHeight": 48,
      "font": "voice",
      "weight": "regular",
      "rem": 2.75,
      "use": "Dillan's daily sentence at >= 1024"
    },
    "numInput": {
      "size": 26,
      "font": "num",
      "weight": "bold",
      "rem": 1.625,
      "use": "Focused numeric input; never below 16px (iOS Safari zoom)"
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "14": 56,
    "screenMargin": 20
  },
  "radius": {
    "chip": 999,
    "button": 18,
    "card": 24,
    "sheet": 34,
    "dialogDesktop": 24,
    "field": 14,
    "banner": 14
  },
  "size": {
    "minTap": 44,
    "primaryButton": 58,
    "logSetButton": 64,
    "stepper": 56,
    "chip": 36,
    "chipSmall": 30,
    "bottomNav": 64,
    "stickyActions": 61,
    "sidebar": 240,
    "safeArea": "env(safe-area-inset-*)"
  },
  "motion": {
    "settle": {
      "css": "280ms cubic-bezier(.2,.9,.25,1)",
      "use": "Default for everything"
    },
    "quick": {
      "css": "160ms",
      "use": "Toggles, chips, steppers"
    },
    "calm": {
      "css": "520ms",
      "use": "Session complete, sheet reveals of Dillan text"
    },
    "spotDrop": {
      "use": "Signature: dot drops into the cradle on Log set",
      "css": "380ms cubic-bezier(.34,1.3,.5,1) on transform/opacity only"
    },
    "reduceMotion": "prefers-reduced-motion: replace all movement with 150ms opacity crossfades (already in tokens.css)",
    "route": {
      "css": "180ms crossfade; session runner slides up 240ms",
      "use": "Route changes"
    }
  },
  "platform": {
    "target": "Mobile-first responsive web app (brief §4.1)",
    "units": "CSS px; type in rem (root 16px)",
    "breakpoints": {
      "sm": 360,
      "md": 768,
      "lg": 1024,
      "xl": 1280
    },
    "verifyWidths": [
      320,
      360,
      390,
      430,
      768,
      1024,
      1280,
      1440
    ],
    "nav": {
      "phone": "bottom nav, 64px + env(safe-area-inset-bottom)",
      "desktop": "sidebar 240px at >= 1024"
    },
    "contentMaxWidth": {
      "phoneSession": 640,
      "desktop": 1120
    }
  },
  "vibrate": {
    "note": "Optional enhancement via navigator.vibrate (Android Chrome only). Nothing depends on it.",
    "logSet": 20,
    "restEnd": [
      20,
      120,
      20,
      120,
      20
    ],
    "sessionComplete": 30,
    "never": "No vibration for missed or skipped work"
  },
  "saveState": {
    "synced": {
      "dot": "steady",
      "label": "Synced",
      "meaning": "Server acknowledged the write"
    },
    "local": {
      "dot": "hold",
      "label": "Saved on this device",
      "meaning": "In the IndexedDB outbox; will retry while the app is open"
    },
    "failed": {
      "dot": "accentText",
      "label": "Didn't sync",
      "meaning": "Retries exhausted or rejected; previous value still shown; Retry offered"
    }
  }
}